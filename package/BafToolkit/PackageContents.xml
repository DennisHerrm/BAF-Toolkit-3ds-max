<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="3ds Max"
    ProductType="Application"
    Name="BafToolkit"
    Description="BAF Toolkit - Star Wars Episode I: The Phantom Menace"
    AppVersion="1.8.3"
    FriendlyVersion="1.8.3"
    Author="DH"
    UpgradeCode="{8D40B7E5-1C96-4A73-B208-E5364F91D7A2}"
    ProductCode="{C4B0E7A2-1D68-4935-B0FC-27E5194A83DB}">

    <!-- Alles hier gegen die "Autodesk Application Plug-in Package Format
         Specification" fuer 3ds Max geprueft, nicht aus einem anderen
         Projekt uebernommen. tools\PRUEFE_PAKET.py prueft es nach.

         Pflicht bei 3ds Max: AutodeskProduct, ProductType, AppVersion
         (Form MMM.mmm.bbb) und UpgradeCode.

         ProductCode ist bei 3ds Max ANDERS als bei AutoCAD nur optional -
         die Doku sagt das ausdruecklich. Gebraucht wird er erst beim
         Hochladen in den Autodesk App Store; dann bei jeder Aenderung von
         AppVersion neu vergeben. UpgradeCode dagegen ist die dauerhafte
         Kennung und darf sich NIE aendern: Max laedt je UpgradeCode nur ein
         Paket, und zwar das mit der hoeheren AppVersion.

         FriendlyVersion steht nicht in der Max-Spezifikation, sondern kommt
         aus der AutoCAD-/App-Store-Welt. Schadet nicht und wird beim
         Hochladen gebraucht, deshalb bleibt es stehen.

         Beim naechsten Versionssprung: AppVersion, FriendlyVersion, alle
         Version="1.8.3", ProductCode, BAFIMPORT_VERSION_STR in
         baftoolkit.h und sExpectedVersion in BafImport.mcr. PRUEFE_PAKET.py
         vergleicht die drei letzten miteinander. -->

    <!-- <CompanyDetails> ist PFLICHT. Fehlt der Knoten, laedt das Plugin
         nicht - auch wenn sonst alles stimmt und ohne verwertbare Meldung.
         Der Inhalt ist dagegen egal. -->
    <CompanyDetails Name="DH" />

    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />

    <!-- ========================================================
         1. Das Plugin selbst.

         Pro Max-Version ein eigener Block mit SeriesMin = SeriesMax.
         Die Doku ist dazu deutlich: "3ds Max does not test for binary
         compatibility." Ein Block mit SeriesMin="2016" SeriesMax="2027"
         wuerde also EINE DLU in alle zwoelf Jahrgaenge laden - und eine
         gegen das 2016er SDK gebaute DLU in 2027 endet im Absturz, nicht
         in einer Meldung.

         Umgekehrt gilt dasselbe: ein zu enger Bereich laedt gar nicht.
         Steht dort 2015 und laeuft 2016, wird das Plugin uebersprungen,
         obwohl es binaerkompatibel waere.

         Skripte sind davon nicht betroffen - die teilen sich einen Block
         ueber den ganzen Bereich (siehe unten).

         Nicht installierte SDKs fehlen im output-Ordner; INSTALLIERE.bat
         ueberspringt sie dann, und der Block hier laeuft ins Leere. Das
         ist unschaedlich: Max meldet eine fehlende Datei im max.log.
         ======================================================== -->

    <Components Description="plugins parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2016" />
        <ComponentEntry AppName="BafToolkit" Version="1.8.3"
                        ModuleName="./Contents/2016/BafToolkit.dlu"
                        AppDescription="BAF Toolkit (Phantom Menace)" />
    </Components>

    <Components Description="plugins parts">
